# Variabili della build (Vite le legge alla costruzione: finiscono nel codice del sito, quindi NON sono segreti).
# Copia in .env.local per lo sviluppo, oppure impostale nel servizio di hosting. Senza queste variabili l'app funziona lo stesso:
# le iscrizioni restano in coda sul dispositivo («in attesa di collegamento») e NOI dice «non collegato».

# Indirizzo del Worker ATLAS (vedi atlas/DEPLOY.md), senza barra finale.
VITE_ATLAS_API_URL=

# Accesso con Google (Project ID): i valori sono in app/firebase-applet-config.json.
# VITE_FIREBASE_PROJECT_ID deve essere uguale a FIREBASE_PROJECT_ID del Worker (atlas/wrangler.jsonc).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mimetic-resolver-7szp9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mimetic-resolver-7szp9
VITE_FIREBASE_APP_ID=
