# Copiare in .env.local (non va nel repository). Tutte le variabili sono opzionali: senza, l'app parte in modo "prod"
# con i pagamenti spenti.

# Modo dell'app.
#   demo = versione dimostrativa a file unico (npm run build:demo la imposta da sola): nessun server, nessun Firebase,
#          dati sul dispositivo, "Sblocca il Pass in prova" al posto dell'acquisto.
#   prod = versione vera: dati e Pass vengono dal server in pass/ (VITE_API_URL).
VITE_MODE="prod"

# Indirizzo del server del Pass (cartella pass/), es. https://pass.<tuo-sottodominio>.workers.dev
# Senza indirizzo l'app resta nella modalità locale senza Pass a pagamento.
VITE_API_URL=""

# Link di pagamento Stripe del Pass (Payment Link, 14,99 € una tantum). Come URL di successo del link:
# https://<tuo-dominio>/?pagamento=ok
# Se vuoto o se i pagamenti sono spenti, il pulsante d'acquisto porta alla lista d'attesa.
VITE_STRIPE_LINK=""

# Accende l'acquisto vero: "true" per attivarlo. Va acceso solo dopo i controlli legali e fiscali; tutto il resto è "false".
VITE_PAYMENTS_ENABLED="false"

# URL del Worker ATLAS (cartella atlas/ del repo), es. https://atlas.<tuo-sottodominio>.workers.dev
# Senza URL: Project ID e consensi restano sul dispositivo e sull'account Google, classifica NOI spenta.
VITE_ATLAS_API_URL=""
