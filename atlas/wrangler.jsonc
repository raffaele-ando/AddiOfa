{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "mimetic-resolver-7szp9",
    "ACCOUNT_ID_PREFIX": "PRJ",
    // Origini del sito che possono chiamare l'API dal browser, separate da virgole, senza barra finale
    // (es. "https://addiofa.example"). Va compilato prima del deploy: vuoto = il browser blocca le chiamate.
    // "*" è accettato solo in locale (.dev.vars con ALLOW_TEST_TOKENS=true).
    "ALLOWED_ORIGINS": "",
    // Richieste al minuto per IP su POST /v1/signups
    "SIGNUP_RATE_LIMIT": "10"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas",
      "database_id": "fae6dddc-a787-474b-9699-e23bab53eb4d",
      "migrations_dir": "migrations"
    }
  ]
}
